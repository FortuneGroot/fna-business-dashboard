{
  "name": "fna-client-app",
  "private": true,
  "version": "0.1.0",
  "description": "Fortune & Automations branded application shell for app.fortuneandautomations.com",
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "test": "node ./node_modules/tsx/dist/cli.mjs --test tests/sync.test.ts tests/onboarding.test.ts",
    "check:readiness": "node ./node_modules/tsx/dist/cli.mjs scripts/check-client-readiness.ts",
    "qa": "python qa/run_static_audit.py"
  },
  "dependencies": {
    "next": "^15.5.25",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.16.10",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "tsx": "^4.23.13",
    "typescript": "5.6.2"
  }
}
