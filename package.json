{
  "name": "fna-client-app",
  "private": true,
  "version": "0.1.0",
  "description": "Fortune & Automations branded application shell for app.fortuneandautomations.com",
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "test": "node scripts/run-tests.mjs",
    "check:readiness": "node --require ./scripts/stub-server-only.cjs ./node_modules/tsx/dist/cli.mjs scripts/check-client-readiness.ts",
    "client:prepare": "node --require ./scripts/stub-server-only.cjs ./node_modules/tsx/dist/cli.mjs scripts/client-prepare.ts",
    "client:validate": "node --require ./scripts/stub-server-only.cjs ./node_modules/tsx/dist/cli.mjs scripts/validate-client-env.ts",
    "client:generate": "node --require ./scripts/stub-server-only.cjs ./node_modules/tsx/dist/cli.mjs scripts/generate-client-deployment.ts",
    "test:db": "node scripts/run-tests.mjs --suite db",
    "qa": "python qa/run_static_audit.py",
    "verify:auth": "node scripts/verify-auth-runtime.mjs",
    "test:unit": "node scripts/run-tests.mjs --suite unit",
    "test:db:concurrency": "node scripts/run-tests.mjs --suite realpg"
  },
  "dependencies": {
    "next": "^15.5.25",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@types/node": "20.16.10",
    "@types/pg": "8.23.1",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "embedded-postgres": "18.6.0-beta.19",
    "pg": "8.23.1",
    "tsx": "^4.23.13",
    "typescript": "5.6.2"
  }
}
