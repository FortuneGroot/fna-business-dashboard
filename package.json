{
  "name": "fna-client-app",
  "private": true,
  "version": "0.1.0",
  "description": "Fortune & Automations branded application shell for app.fortuneandautomations.com",
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "test": "node --import tsx --test tests/sync.test.ts tests/onboarding.test.ts tests/tenant.test.ts tests/auth.test.ts tests/client-facing-copy.test.ts tests/supabase-rest-auth.test.ts",
    "check:readiness": "node ./node_modules/tsx/dist/cli.mjs scripts/check-client-readiness.ts",
    "client:prepare": "node ./node_modules/tsx/dist/cli.mjs scripts/client-prepare.ts",
    "client:validate": "node ./node_modules/tsx/dist/cli.mjs scripts/validate-client-env.ts",
    "client:generate": "node ./node_modules/tsx/dist/cli.mjs scripts/generate-client-deployment.ts",
    "qa": "python qa/run_static_audit.py",
    "verify:auth": "node scripts/verify-auth-runtime.mjs"
  },
  "dependencies": {
    "next": "^15.5.25",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.16.10",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "tsx": "^4.23.13",
    "typescript": "5.6.2"
  }
}
