# Fortune & Automations — copy to .env.local. Never commit secrets.
# Intended public app: https://app.fortuneandautomations.com
# System links (DNS owner action, not configured here): https://links.fortuneandautomations.com

GHL_DRY_RUN=true
ALLOW_PRODUCTION_CONTACT_WRITES=false

# Configured client location for THIS deployment (defaults to F&A LIVE Preview).
# Never set to the protected Master (NQwD3zdWCuBSVpOuzybj) — absolute block.
GHL_LOCATION_ID=kIXDnRuhkj6HLR1g6V6V
FORBIDDEN_MASTER_LOCATION_ID=NQwD3zdWCuBSVpOuzybj
GHL_PIPELINE_ID=6XevPh4T3rX0qAYRfuta

# Private Integration Token (pit-...). Leave empty until owner pastes a LIVE token.
# Do not put a Master token here.
GHL_API_TOKEN=

# Per-deployment webhook secret (server-side only). Never put in GHL Custom Values.
GHL_WEBHOOK_SECRET=

# Fake-contact test mode: only @example.invalid / @example.com emails accepted when dry-run is true.
FAKE_CONTACT_ONLY=true

# When true, webhook requests require a valid GHL_WEBHOOK_SECRET even in dry-run.
# When false and dry-run with no secret configured, development ingestion is allowed.
GHL_WEBHOOK_ENFORCE_SECRET=false

# Durable sync store (Supabase / Postgres) — server-side only.
# Leave empty to use in-memory fallback (local/tests).
# Never put SERVICE_ROLE_KEY in NEXT_PUBLIC_* vars or client code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional path to a client onboarding / tenant config JSON.
# When set, the whole deployment represents that one client.
# When empty, defaults to embedded F&A LIVE Preview config.
# Example fake client: config/examples/fake-roofing-client.json
CLIENT_CONFIG_PATH=

# Dashboard auth (httpOnly cookie sessions).
# Production (VERCEL_ENV=production) FAIL-CLOSES if AUTH_SECRET is missing.
# Preview/local may stay open without AUTH_SECRET (Vercel Deployment Protection).
# Set AUTH_FAIL_CLOSED=true to force fail-closed outside Production.
AUTH_SECRET=
AUTH_FAIL_CLOSED=false
AUTH_DEV_OPEN=false
AUTH_OWNER_EMAIL=
AUTH_OWNER_PASSWORD=
AUTH_OWNER_NAME=Owner
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_PASSWORD=
AUTH_ADMIN_NAME=Admin
AUTH_CLIENT_EMAIL=
AUTH_CLIENT_PASSWORD=
AUTH_CLIENT_NAME=Client

# Owner-supplied public values (emails/URLs/ZIP) are NOT env vars.
# Edit exactly one code insertion point: src/lib/owner-values.ts
# Then mirror the same verified value into the matching FNA | Custom Value in GHL.

# Persistence:
# If SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set → postgres durable store.
# Otherwise → in-memory process-local fallback.
# Apply SQL in supabase/migrations/ before enabling Postgres in Preview/Production.
