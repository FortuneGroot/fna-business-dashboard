# Fortune & Automations — copy to .env.local. Never commit secrets.
# Intended public app: https://app.fortuneandautomations.com
# System links (DNS owner action, not configured here): https://links.fortuneandautomations.com

# Supabase — server-side only. Never put SERVICE_ROLE_KEY in NEXT_PUBLIC_* vars or client code.
# supabase mode: the service role is used only by the audited workspace-logo upload.
# legacy mode: it reads the legacy session store and the frozen legacy snapshot (removed at T6).
# Leave empty locally to use in-memory fallbacks.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Sign-in provider: legacy (default, env-configured users below) or supabase
# (Supabase Auth + workspace memberships). Any other value fails closed with 503.
# supabase mode also needs SUPABASE_URL and the anon/publishable key — server-only,
# never NEXT_PUBLIC_*. SUPABASE_PUBLISHABLE_KEY is accepted as an alias.
AUTH_PROVIDER=legacy
SUPABASE_ANON_KEY=

# supabase mode: origin used in invitation links handed to the inviter (server-only).
# Leave empty locally; links then use the request origin.
APP_ORIGIN=

# Legacy dashboard auth (httpOnly cookie sessions) — kept until T6.
# Production (VERCEL_ENV=production) FAIL-CLOSES if AUTH_SECRET is missing.
# Preview/local may stay open without AUTH_SECRET (Vercel Deployment Protection).
# Set AUTH_FAIL_CLOSED=true to force fail-closed outside Production.
AUTH_SECRET=
AUTH_FAIL_CLOSED=false
AUTH_DEV_OPEN=false
AUTH_OWNER_EMAIL=
AUTH_OWNER_PASSWORD=
AUTH_OWNER_NAME=Owner
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_PASSWORD=
AUTH_ADMIN_NAME=Admin
AUTH_CLIENT_EMAIL=
AUTH_CLIENT_PASSWORD=
AUTH_CLIENT_NAME=Client

# Apply SQL in supabase/migrations/ before enabling Postgres in Preview/Production.
